# Copiá este archivo a .env y completalo. Nunca subas el .env al repositorio.

# Servidor HTTP y panel web
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# MySQL 8 (las migraciones de migrations/ se aplican solas al arrancar)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=veripago_db
# Solo para docker compose (crea el usuario de la base)
DB_ROOT_PASSWORD=

# Redis 7 (cola de espera de 3 min y órdenes /cobrar). Sin Redis quedan en memoria.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Clave de 32 bytes para encriptar los tokens de Mercado Pago (AES-256-GCM).
# Generá una propia, por ejemplo: openssl rand -base64 24
MASTER_KEY=

# Google Gemini (lectura de comprobantes)
GEMINI_API_KEY=
GEMINI_MODEL=

# Mercado Pago (OAuth y webhooks de comercios)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:8080/oauth/mp/callback
MP_WEBHOOK_SECRET=

# Mercado Pago de la plataforma SaaS (opcional: para cobrar suscripciones con Checkout Pro)
MP_PLATFORM_ACCESS_TOKEN=
USD_ARS_RATE=1200

# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Modo demo: simulador y pagos simulados, todo en memoria. NUNCA true en producción.
DEMO_MODE=false

# Acceso al panel de Super-Admin de la plataforma
ADMIN_USER=admin
ADMIN_PASSWORD=
